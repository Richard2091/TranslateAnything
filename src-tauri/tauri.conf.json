{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Translate Anything",
  "version": "0.2.3",
  "identifier": "com.richard.translateanything",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "TradChinese",
          "English",
          "Japanese",
          "Korean",
          "German",
          "French",
          "Spanish",
          "Russian",
          "PortugueseBR"
        ],
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
