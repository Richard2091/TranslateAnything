{
  "hotkey": "Alt+T",
  "frame_click_through": true,
  "frame_corner_radius": 0,
  "target_lang": "zh-CN",
  "mode": "ocr",
  "ocr_lang": "auto",
  "engine": "edge",
  "fallback": ["bing", "google_free"],
  "proxy": "http://127.0.0.1:7897",
  "persist_cache": true,
  "builtin_glossary": true,
  "glossary": {
    "Claude": "Claude",
    "GitHub": "GitHub",
    "Opus": "Opus",
    "Artifacts": "工件"
  },
  "glossary_apps": {
    "code.exe": { "Terminal": "终端" }
  },
  "filter": {
    "keep_patterns": ["^v\\d+(\\.\\d+)*$"],
    "force_translate": [],
    "apps": {}
  },
  "immersive": {
    "enabled": true,
    "hotkey": "Alt+Shift+T",
    "targets": [
      {
        "name": "Claude 客户端",
        "enabled": true,
        "exe": "C:\\Users\\你的用户名\\AppData\\Local\\AnthropicClaude\\app-版本号\\claude.exe",
        "args": "",
        "port": 39222,
        "url_prefixes": [],
        "skip_selectors": [],
        "auto_relaunch": true
      }
    ]
  },
  "engines": {
    "edge": {
      "proxy": "direct"
    },
    "bing": {
      "proxy": "direct"
    },
    "google_free": {},
    "microsoft": {
      "api_key": "在此填写你的 key",
      "region": "eastasia"
    },
    "deepl": {
      "api_key": "在此填写你的 key"
    },
    "deeplx": {
      "base_url": "http://127.0.0.1:1188/translate"
    },
    "openai": {
      "base_url": "https://api.example.com/v1",
      "api_key": "在此填写你的 key",
      "model": "gpt-4o-mini",
      "concurrency": 2
    }
  }
}
